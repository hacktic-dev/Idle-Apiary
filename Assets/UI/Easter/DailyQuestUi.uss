.daily-quest-ui {
    margin-right: auto;
    margin-left: auto;
    position: absolute;
    margin-top: auto;
    margin-bottom: auto;
    width: 100%;
    max-width: 100%;
    align-self: center;
}

.portrait .daily-quest-ui {
    height: 100%;
}

.landscape .daily-quest-ui {
    bottom: 38%;
    height: 25%;
    width: 30%;
    min-width: 350px;
    min-height: 225px;
}

.main-container {
  align-self: center;
  display: flex;
  overflow: hidden;

  padding: 6px;

  width: 100%;
  height: 100%;

  border-width: 2px;
  border-radius: 8px;
  background-image: url("project://database/Assets/Textures/background_blur_dark.png");
	-unity-background-scale-mode: scale-and-crop;
}

.portrait .main-container
{
    margin-top: auto;
    margin-bottom: auto;
    height: 40%;
    width: 90%;
}

.close-button {
    background-color: rgba(180, 0, 0, 0.8);
    border-radius: 5px;
    padding: 5px 10px;
    color: white;
    font-size: 16px;
    margin-top: 8px;
    width: 40%;
    margin-left: auto;
    margin-right: auto;
    align-self: center;
    position: relative;
    height: 7%;
    min-height: 30px;
}

.claim-button {
    background-color: rgba(113, 213, 76, 0.7);
    border-radius: 5px;
    padding: 5px 10px;
    color: white;
    font-size: 16px;
    margin-top: 8px;
    width: 40%;
    margin-left: auto;
    margin-right: auto;
    align-self: center;
    position: relative;
    height: 7%;
    min-height: 30px;
}

.quest-container
{
    height: 80%;
}

.title {
    margin: 5px;
    color: white;
    align-self: center;
    white-space: normal;
    -unity-text-align: middle-center;
}

.portrait .title {
    font-size: 11.5px;
}

.landscape .title {
    font-size: 20px;
}

.quest-text {
    margin: 5px;
    color: white;
    align-self: center;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 20px;
}

.unity-text-element
{
	-unity-font-definition: url("project://database/Assets/Winter Selfie SDF.asset");
	text-shadow: 4px 4px 9.5px rgba(0,0,0,0.5);
}

.horizontal-container
{
    flex-direction: row;
    align-self: center;
    margin-top: 12%;
}

.ticket-icon
{
  margin-top: 0px;
  width: 30px;
  height: 30px;
  background-image: url("project://database/Assets/Icons/ticket.png");
}

.portrait .ticket-icon
{
  width: 20px;
  height: 20px;
}