.daily-rewards-wheel {
    margin-right: auto;
    margin-left: auto;
    position: absolute;
    margin-top: auto;
    margin-bottom: auto;
    width: 100%;
    max-width: 100%;
    align-self: center;
}

.portrait .daily-rewards-wheel {
    height: 100%;
}

.landscape .daily-rewards-wheel {
    bottom: 38%;
    height: 40%;
    width: 30%;
    min-width: 350px;
    min-height: 225px;
}

.main-container {
  align-self: center;
  display: flex;
  overflow: hidden;

  padding: 6px;

  width: 100%;
  height: 100%;

  border-width: 2px;
  border-radius: 8px;
  background-image: url("project://database/Assets/Textures/background_blur_dark.png");
	-unity-background-scale-mode: scale-and-crop;
}

.close-button {
    background-color: rgba(180, 0, 0, 0.8);
    border-radius: 5px;
    padding: 5px 10px;
    color: white;
    font-size: 16px;
    margin-top: 8px;
    width: 40%;
    margin-left: auto;
    margin-right: auto;
    align-self: center;
    position: relative;
    height: 7%;
    min-height: 30px;
}

.spin-button {
    background-color: rgba(0, 180, 0, 0.8);
    border-radius: 5px;
    padding: 5px 10px;
    color: white;
    font-size: 16px;
    margin-top: 8px;
    width: 40%;
    margin-left: auto;
    margin-right: auto;
    align-self: center;
    position: relative;
    height: 7%;
    min-height: 30px;
}

.title {
    margin: 5px;
    color: white;
    align-self: center;
    white-space: normal;
    -unity-text-align: middle-center;
}

.portrait .title {
    font-size: 11.5px;
}

.landscape .title {
    font-size: 20px;
}

.wheel-container
{
    background-color:rgba(0, 0, 0, 0.5);
     
    width:  100%;
    height: 250px;

    padding: 5px;

    overflow: hidden;
    border-radius: 20px;
    flex-direction: row;
}

.wheel {
    flex-direction: column;

    width: 100%;
    height: 1640px;

    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgba(255, 255, 255, 0);
}

.Slot__Item {
    width: 100%;
    height: 82px;

    scale: .8;
    opacity: 0.8;

    transition-property: opacity, scale;
    transition-duration: 0.1s;
    transition-timing-function: ease-in-out;
}

.Slot__Item--Main {
    scale: 1;
    opacity: 1;
}