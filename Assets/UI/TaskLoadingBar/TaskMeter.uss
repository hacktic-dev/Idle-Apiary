.task-meter {
  bottom: 50px;
}

.my-container {
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.title {
  color: #a8f5c2; /* Pastel green */
  font-size: 48px;
  -unity-font-style: bold;

  -unity-text-outline-width: 2px;
  -unity-text-outline-color: #8ed8a8; /* Lighter pastel green */
}

.slider {
  width: 200px; /* Set the width of the slider */
}

.slider .slider__background {
    background-color: #8ed8a8; /* Pastel green */
    border-width: 2px;
    border-color: #7cbf94; /* Slightly darker pastel green */
}

.slider .slider__foreground {
    background-color: #a8f5c2; /* Pastel green */
    border-width: 2px;
    border-color: #7cbf94; /* Slightly darker pastel green */
}

.slider-cooldown .slider__foreground {
    background-color: #7cbf94; /* Slightly darker pastel green */
    border-width: 2px;
    border-color: #7cbf94;
}

.slider .slider__dot {
        display: none;
}
.slider .slider__knob {
    display: none;
}

.hiden {
    display: none;
}
